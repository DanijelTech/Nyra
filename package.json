{
  "name": "nyra-workspace",
  "version": "1.0.4",
  "description": "Build the Nyra humanoid workspace (ROBOTO ORIGIN / RPO): submodules, roboparty_deploy (colcon), uv environments, compatibility contract and the EvoLayer test suite \u2014 one command, one manifest.",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "type": "commonjs",
  "bin": {
    "nyra-build": "tools/build/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "os": [
    "linux"
  ],
  "files": [
    "tools/build/cli.js",
    "tools/build/nyra_build.py",
    "tools/build/README.md",
    "tools/build/tests/",
    "package.json"
  ],
  "scripts": {
    "build": "node tools/build/cli.js build",
    "build:strict": "node tools/build/cli.js build --strict",
    "build:dry": "node tools/build/cli.js build --dry-run --verbose",
    "build:envs": "node tools/build/cli.js build --with-envs",
    "verify": "node tools/build/cli.js verify",
    "plan": "node tools/build/cli.js plan",
    "doctor": "node tools/build/cli.js doctor",
    "status": "node tools/build/cli.js status",
    "clean": "node tools/build/cli.js clean",
    "clean:all": "node tools/build/cli.js clean --venvs",
    "test": "node tools/build/cli.js test",
    "prepack": "node -e \"const fs=require('fs');for (const p of ['tools/build/tests/__pycache__','.pytest_cache','tools/build/.pytest_cache']) fs.rmSync(p,{recursive:true,force:true});\""
  },
  "keywords": [
    "robotics",
    "humanoid",
    "ros2",
    "isaac-lab",
    "mujoco",
    "build"
  ]
}
